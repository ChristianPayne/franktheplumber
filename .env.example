# EmailJS credentials (https://www.emailjs.com)
EMAILJS_SERVICE=
EMAILJS_TEMPLATE=
EMAILJS_USERID=
EMAILJS_API_KEY=

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) keys.
# Create a site at https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_ prefix is required so the site key is available in the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
